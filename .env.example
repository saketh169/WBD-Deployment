CLOUDINARY_API_SECRET=your_cloudinary_secret
EMAIL_USER=your_email
EMAIL_PASS=your_email_password
USDA_API_KEY=your_usda_key
GEMINI_API_KEY=your_gemini_key
ADMIN_SIGNIN_KEY=your_admin_key
